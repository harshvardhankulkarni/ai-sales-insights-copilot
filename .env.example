# Copy this file to .env and fill in real values. Never commit .env.

# Slot 1: OpenRouter free tier (default copilot model)
OPENROUTER_API_KEY=your-openrouter-key
LLM_MODEL=openai/gpt-oss-20b:free

# Slot 2: OpenRouter paid tier. Same key, different model.
# Used when the free tier is rate-limited or down.
# Needs credits on the OpenRouter account. Costs about $0.0001 per question.
LLM_MODEL2=openai/gpt-4o-mini

# Slot 3: Gemini via OpenAI-compatible endpoint.
# Get a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-key
# LLM_MODEL3=gemini-2.0-flash

# Sales data generator
SALES_DAYS=365